    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.126.0"
  }
}
